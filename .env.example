# URL publik toko (dipakai untuk callback Midtrans & metadata).
# Saat deploy, ganti dengan domain kamu, contoh: https://toko-saya.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Kunci enkripsi (opsional). Ganti dengan string acak min. 32 karakter.
NEXT_PUBLIC_ENCRYPTION_KEY=change-me-min-32-characters

# Logo brand (opsional). Kosongkan untuk memakai logo dari pengaturan admin.
NEXT_PUBLIC_BRAND_LOGO_URL=

# Cloudflare Turnstile (opsional). Kosongkan bila tidak dipakai.
TURNSTILE_SECRET_KEY=

# Folder data (opsional, default ./data).
# GTSHOP_DATA_DIR=./data

# Proxy egress (opsional, hanya bila server kamu butuh proxy untuk ke Midtrans).
# HTTP_PROXY=
# HTTPS_PROXY=
